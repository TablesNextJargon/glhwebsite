{
  "name": "george-hadow-concerts",
  "version": "1.0.0",
  "description": "George Hadow concert scraper and display website",
  "main": "pages/index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "check:contact": "tsc -p workers/contact/tsconfig.json",
    "test:contact": "node --experimental-strip-types workers/contact/test/contact.test.ts",
    "contact:dev": "cd workers/contact && cf dev",
    "contact:build": "cd workers/contact && cf build",
    "contact:deploy": "cd workers/contact && cf deploy"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "next": "^14.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "cf": "^1.0.0-rc.6",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "george-hadow",
    "concerts",
    "music",
    "scraper"
  ],
  "author": "George Hadow",
  "license": "MIT",
  "workspaces": [
    "workers/contact"
  ]
}
